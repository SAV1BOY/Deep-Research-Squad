# ============================================================
# DEEPRESEARCH SQUAD — swipe.config
# Swipe file configuration for research examples and references
# ============================================================

swipe:
  version: "2.0.0"
  description: "Gold-standard examples of research outputs for calibration and training"

  directories:
    swipe: "swipe/"
    sources: "swipe-sources/"

  categories:
    deep-dive-reports:
      description: "Complete deep-dive research report examples"
      quality_bar: "gold"
      files:
        - mckinsey-deep-dive-example.md
        - a16z-market-analysis-example.md
        - berkshire-annual-letter-analysis.md

    executive-briefs:
      description: "1-2 page executive brief examples"
      quality_bar: "gold"
      files:
        - one-page-brief-examples.md
        - decision-brief-examples.md

    market-maps:
      description: "Market landscape and mapping examples"
      quality_bar: "gold"
      files:
        - market-map-examples.md
        - landscape-analysis-examples.md

    competitor-files:
      description: "Competitive intelligence teardown examples"
      quality_bar: "gold"
      files:
        - competitor-teardown-examples.md
        - competitive-intelligence-examples.md

    evidence-tables:
      description: "Evidence table and claim verification examples"
      quality_bar: "gold"
      files:
        - evidence-table-gold-examples.md
        - claim-verification-examples.md

    timeline-maps:
      description: "Timeline and evolution analysis examples"
      quality_bar: "gold"
      files:
        - technology-timeline-examples.md
        - market-evolution-examples.md

    scenario-memos:
      description: "Scenario planning and analysis examples"
      quality_bar: "gold"
      files:
        - scenario-planning-examples.md
        - strategic-scenario-examples.md

    due-diligence-packs:
      description: "Due diligence investigation examples"
      quality_bar: "gold"
      files:
        - investment-dd-examples.md
        - vendor-dd-examples.md

    technical-evaluations:
      description: "Technical evaluation and architecture review examples"
      quality_bar: "gold"
      files:
        - architecture-evaluation-examples.md
        - ai-evaluation-examples.md

    literature-syntheses:
      description: "Literature review and synthesis examples"
      quality_bar: "gold"
      files:
        - systematic-review-examples.md
        - state-of-art-examples.md

  sources:
    consulting-firms:
      description: "McKinsey, BCG, Bain, Deloitte research outputs"
      file: "consulting-firms.md"
    think-tanks:
      description: "Brookings, RAND, Chatham House publications"
      file: "think-tanks.md"
    academic-journals:
      description: "Nature, Science, Lancet, top journals"
      file: "academic-journals.md"
    investigative-journalism:
      description: "NYT, Reuters, Bloomberg, FT investigations"
      file: "investigative-journalism.md"
    investor-memos:
      description: "VC/PE memos, shareholder letters"
      file: "investor-memos.md"
    public-filings:
      description: "SEC, CVM, public registries"
      file: "public-filings.md"
    regulatory-databases:
      description: "Regulation databases and compliance"
      file: "regulatory-databases.md"
    company-documents:
      description: "S-1s, 10-Ks, annual reports"
      file: "company-documents.md"

  usage:
    calibration: "Use swipe files to calibrate output quality before delivery"
    training: "Reference swipe examples when onboarding new research workflows"
    quality_check: "Compare research outputs against swipe standards"
